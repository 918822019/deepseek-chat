{
  "appId": "dev.chatdemo.client",
  "productName": "Chat Demo",
  "artifactName": "Chat-Demo-${version}-${arch}-setup.${ext}",
  "directories": {
    "output": "release/windows"
  },
  "files": ["desktop/main.mjs", "dist/**/*", "!node_modules/**/*"],
  "npmRebuild": false,
  "nsis": {
    "differentialPackage": false
  },
  "win": {
    "electronLanguages": ["en-US", "zh-CN", "zh-TW"],
    "icon": "desktop/icon.ico",
    "target": "nsis"
  }
}
